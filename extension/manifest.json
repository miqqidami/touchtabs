{
  "manifest_version": 3,
  "name": "TouchTabs",
  "version": "1.0.0",
  "description": "Shows your tab strip on the MacBook Pro Touch Bar. Requires the free TouchTabs macOS app.",
  "homepage_url": "https://github.com/miqqidami/touchtabs",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["tabs", "tabGroups", "favicon", "alarms"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "TouchTabs",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
